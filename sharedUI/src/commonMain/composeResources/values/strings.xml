    <string name="mute_consequence_1">• You won’t see the user in your home feed</string>
    <string name="mute_consequence_2">• You won’t see other people boosting the user</string>
    <string name="mute_consequence_3">• You won’t see other people mentioning the user</string>
    <string name="mute_consequence_4">• You won’t see the user in public timelines</string>
    <string name="mute_consequence_5">The user has no way of knowing they have been muted.</string>
    <string name="block_consequence_1">• You won’t see the user in your home feed</string>
    <string name="block_consequence_2">• You won’t see other people boosting the user</string>
    <string name="block_consequence_3">• You won’t see other people mentioning the user</string>
    <string name="block_consequence_4">• You won’t see the user in public timelines</string>
    <string name="block_consequence_5">• You won’t see notifications from that user</string>
    <string name="block_consequence_6">• The user is forced to unfollow you</string>
    <string name="block_consequence_7">• The user cannot follow you</string>
    <string name="block_consequence_8">• The user won’t see other people’s boosts of you</string>
    <string name="block_consequence_9">• The user won’t see you in public timelines</string>
    <string name="block_consequence_10">If you and the blocked user are on the same server, the blocked user will not be able to view your posts on your profile while logged in.</string>
